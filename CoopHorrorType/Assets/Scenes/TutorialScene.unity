  m_Script: {fileID: 11500000, guid: 8704672fbb87a71488cc70ac39a1ed68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    speakerName: Serg
    voiceClip: {fileID: 8300000, guid: ccd2409bff884684abe30c8937ed94a7, type: 3}
    phrases:
    - text: Pour commencer...
      duration: 1
    - text: "...voil\xE0 tout ce dont vous aurez besoin pour l'entrainement"
      duration: 2
    - text: Vous voyez ca ? Les gros tuyaux noirs ?
      duration: 2
    - text: Et je parle pas de ma...
      duration: 1.5
    - text: "Mais PUTAIN ! Qui a \xE9crit \xE7a sur la note ?!"
      duration: 2
    - text: "J'en peux plus, j'essaie d'\xEAtre s\xE9rieux l\xE0 !"
      duration: 2
    - text: Bref !
      duration: 1
    - text: "\xC9quipez votre Cl\xE9 \xE0 Molette..."
      duration: 1.5
    - text: "...et d\xE9vissez les tuyaux un peu plus fonc\xE9s !"
      duration: 2
