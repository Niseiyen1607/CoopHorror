--- !u!114 &106578208
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 106578206}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f511fe8edc869944900ec590257e662, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  vo1_Intro:
    speakerName: Serge
    voiceClip: {fileID: 8300000, guid: f2d9aaa48f0315f4da8727265b72f2ee, type: 3}
    phrases:
    - text: "All\xF4 ?"
      duration: 1
    - text: "Comment \xE7a marche ce truc..."
      duration: 2.5
    - text: Voila! Bonjour, je suis Serge, votre patron.
      duration: 2
    - text: "Tout d'abord, f\xE9licitations pour votre embauchement !"
      duration: 2
    - text: Comme vous le savez, notre ville est maudite.
      duration: 2.5
    - text: "Et cette mal\xE9diction a affect\xE9 notre precieuse eau !"
      duration: 2.5
    - text: Certaines zones sont devenues le lieu parfait...
      duration: 2
    - text: ...pour la naissance de monstres !
      duration: 1.6
    - text: "Vous \xEAtes actuellement en zone d'entra\xEEnement..."
      duration: 2
    - text: ...pour apprendre les bases.
      duration: 1.2
    - text: Poursuivez votre chemin pour commencer l'entrainement
      duration: 2
  vo3_UnscrewPipe:
    speakerName: Serge
    voiceClip: {fileID: 8300000, guid: b96ac923599f4164ba3275acf99752da, type: 3}
    phrases:
    - text: Parfait !
      duration: 1
    - text: Ramassez les tuyaux neufs en Zormium purifiee !
      duration: 2
    - text: Selon votre CV, vous avez de la force dans les bras.
      duration: 2.5
    - text: Vous pouvez maintenenir [Clic Gauche]...
      duration: 1.5
    - text: ...pour lancer le tuyau vers l'emplacement !
      duration: 2
    - text: Par contre...
      duration: 1
    - text: "...votre test d'agilit\xE9 \xE9tait CATASTROPHIQUE !"
      duration: 2.5
    - text: Si vous courez avec [Shift]...
      duration: 1.5
    - text: "...vous l\xE2cherez imm\xE9diatement l'objet en main !"
      duration: 2
    - text: "Une fois le tuyau plac\xE9..."
      duration: 1.5
    - text: "...appuyez sur [E] pour le tourner \xE0 90\xB0."
      duration: 2
    - text: Mettez-le dans le bon sens !
      duration: 1.5
    - text: Et en cas d'erreur...
      duration: 1
    - text: "...retirez-le avec la Cl\xE9 \xE0 Molette."
      duration: 2
  vo4_SnapPipe:
    speakerName: Serge
    voiceClip: {fileID: 8300000, guid: 051030314e5c76b4a8d83db70cab4b1c, type: 3}
    phrases:
    - text: Fantastique !
      duration: 1
    - text: "Ne laissez pas tra\xEEner ces vieux tuyaux !"
      duration: 2
    - text: "Lancez-les vers la lumi\xE8re verte !"
      duration: 2
    - text: Tout ce qui va ici vous rapporte du CASH !
      duration: 2
    - text: "Et si vous \xEAtes chanceux..."
      duration: 1.5
    - text: ...il y a des objets de valeur dans les environs.
      duration: 2
    - text: Cherchez bien !
      duration: 1
  staticStartSound: {fileID: 8300000, guid: 9594482f26239164a8c553dc9e39cbe3, type: 3}
  startDoor: {fileID: 181402686}
